{
  "name": "financial-verifier-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Layered DDD/CQRS financial verification API",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "db:migrate": "mikro-orm migration:up",
    "db:seed": "mikro-orm seeder:run --class InitialVerificationSeeder",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "jest --runInBand",
    "test:smoke": "node test/api.smoke.mjs",
    "test:matching": "node test/matching.smoke.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@mikro-orm/core": "6.6.8",
    "@mikro-orm/migrations": "6.6.8",
    "@mikro-orm/nestjs": "6.1.1",
    "@mikro-orm/postgresql": "6.6.8",
    "@mikro-orm/seeder": "6.6.8",
    "@nestjs/common": "10.4.20",
    "@nestjs/core": "10.4.20",
    "@nestjs/cqrs": "10.2.8",
    "@nestjs/platform-express": "10.4.20",
    "@nestjs/swagger": "7.4.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.6.8",
    "@nestjs/testing": "10.4.20",
    "@types/express": "4.17.23",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.7",
    "jest": "29.7.0",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "mikro-orm": { "useTsNode": true, "configPaths": ["./src/mikro-orm.config.ts"] },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/test/**/*.spec.ts"],
    "clearMocks": true
  }
}
