# Local development only. Docker and the API use the same credentials.
POSTGRES_DB=neuro_symbolic
POSTGRES_USER=verifier
POSTGRES_PASSWORD=verifier_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://verifier:verifier_local@localhost:5432/neuro_symbolic
PORT=3001
# Paths are relative to /backend unless absolute. Use your virtualenv's Python.
PYTHON_BIN=../ml-engine/.venv/bin/python
ML_ENGINE_PATH=../ml-engine
ML_WORKER_CONCURRENCY=2
ML_WORKER_QUEUE_LIMIT=64
SWAGGER_ENABLED=true

# Optional paired-code AI defect review. Key/model are server-only; blank disables it.
# Select a coding model supporting your chosen provider's Chat Completions protocol.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# json_schema (strict structured output), json_object, or text; no automatic fallback.
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT_SECONDS=60
LLM_MAX_COMPLETION_TOKENS=4096
