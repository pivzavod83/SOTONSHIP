{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "lib": ["ES2022", "DOM"],
    "rootDir": ".", "outDir": "dist", "strict": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true, "sourceMap": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
